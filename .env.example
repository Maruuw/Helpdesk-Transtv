# ========================================================
# TRANS TV HELPDESK - FRONTEND ENVIRONMENT TEMPLATE
# ========================================================
# Salin berkas ini menjadi .env untuk konfigurasi lokal.
# JANGAN PERNAH men-commit berkas .env asli ke git repository.

# URL dasar endpoint backend Laravel REST API
VITE_API_BASE_URL=http://localhost:8000/api

# Kunci API untuk proteksi request header (X-API-KEY)
# Samakan dengan HELPDESK_API_KEY di konfigurasi backend Laravel
VITE_API_KEY=transtv-helpdesk-secret-key-2026
