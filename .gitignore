# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Node dependencies & builds
node_modules
dist
dist-ssr
*.local

# Environment variables & secrets
.env*
.env
!.env.example
api/.env*
!api/.env.example

# Database dumps & SQL files (CRITICAL SECURITY: do not commit real data)
*.sql
*.sqlite
*.db
db_helpdesk.sql
scratch_categories.json

# Backend PHP / Laravel dependencies & caches
/api/vendor
/api/storage/*.key
/api/storage/framework/cache/*
/api/storage/framework/sessions/*
/api/storage/framework/views/*
/api/storage/logs/*
!/api/storage/framework/cache/.gitignore
!/api/storage/framework/sessions/.gitignore
!/api/storage/framework/views/.gitignore
!/api/storage/logs/.gitignore

# Do not include markdown files & project notes
*.md

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
